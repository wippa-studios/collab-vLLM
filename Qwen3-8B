    "---\n",
    "## ⛔ Stop the server\n",
    "Run the cell below to stop vLLM and close the tunnel, freeing the GPU."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1f11f87f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 6 — Stop everything\n",
    "tunnel_proc.terminate()\n",
    "vllm_proc.terminate()\n",
    "print(\"🛑 Tunnel and vLLM server stopped.\")\n",
    "print(\"💡 To restart, re-run Cells 2–4 above (you'll get a new URL and API key).\")"
   ]
  }
